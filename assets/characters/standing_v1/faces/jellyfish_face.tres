[gd_resource type="AtlasTexture" load_steps=2 format=3]

; 스탠딩 원화(standing_v1)에서 머리(어깨선 위)만 잘라낸 얼굴 아이콘.
; 근무 배치표 / 휴게실 탑뷰 / 직원 상세 카드가 EmployeeDef.FacePortrait 로 이걸 쓴다.
; 원화를 교체하면 region 만 다시 잡으면 된다 — 새 PNG 를 만들 필요는 없다.

[ext_resource type="Texture2D" path="res://assets/characters/standing_v1/jellyfish_stand.png" id="1_stand"]

[resource]
atlas = ExtResource("1_stand")
; 해파리는 머리를 기울인 구도라 다른 캐릭터처럼 머리만 좁게 잘라내면 오른쪽 얼굴과
; 턱이 잘린다. 사용자가 직접 잡아 준 크롭(원화 상단 504x463)을 그대로 쓰되,
; 표시 위젯이 정사각형이라 세로만 504 로 맞췄다.
region = Rect2(0, 0, 504, 504)
