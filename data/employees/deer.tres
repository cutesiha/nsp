[gd_resource type="Resource" script_class="EmployeeDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/EmployeeDef.cs" id="1_emp"]

[resource]
script = ExtResource("1_emp")
EmployeeId = "deer"
Codename = "사슴"
Tech = 3
Courage = 1
Observation = 3
Trait = "원칙주의"

PersonalityLine1 = "규칙과 절차를 중요하게 여기며, 정해진 순서가 어긋나는 것을 매우 싫어한다."
PersonalityLine2 = "기록과 확인을 꼼꼼하게 하는 편이라 작은 절차 누락이나 앞뒤가 맞지 않는 행동을 잘 발견한다."
PersonalityLine3 = "사람을 싫어해서 거리를 두는 것이 아니라, 감정보다 기준과 책임을 우선해 다소 깐깐하게 보인다."

SpeechStyleLine1 = "존댓말을 사용하며 문장을 또렷하고 정확하게 끝맺는다."
SpeechStyleLine2 = "시간, 순서, 규정처럼 확인 가능한 정보를 구체적으로 말하는 편이다."
SpeechStyleLine3 = "상대가 규칙을 가볍게 여기면 평소보다 단호하고 날카롭게 지적한다."

SpeechExample1 = "22시 14분입니다. 기록에도 남아 있으니 확인해 보세요."
SpeechExample2 = "그 행동은 절차에 없었습니다. 저는 그 점이 가장 이상하다고 생각합니다."
SpeechExample3 = "죄송하지만 예외를 두면 규칙을 만든 의미가 없습니다."
StartRoomId = "storage_room"
IconColor = Color(0.58, 0.76, 0.62, 1)
