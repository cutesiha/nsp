[ext_resource type="Script" path="res://scripts/data/EmployeeDef.cs" id="1_emp"]

[resource]
script = ExtResource("1_emp")
EmployeeId = "dog"
Codename = "개"
Tech = 1
Courage = 3
Observation = 2
Trait = "보호본능"

PersonalityLine1 = "사람을 잘 믿고 붙임성이 좋으며, 주변 사람이 곤란해하면 먼저 나서서 도와주려 한다."
PersonalityLine2 = "자신보다 동료의 안전을 우선하는 편이라 위험한 일도 묵묵히 맡으려 한다."
PersonalityLine3 = "눈치가 아주 빠른 편은 아니지만 한번 믿은 사람에게는 끝까지 의리를 지킨다."

SpeechStyleLine1 = "존댓말을 사용하며 부드럽고 편안하게 말한다."
SpeechStyleLine2 = "상대를 안심시키거나 도와주겠다는 표현을 자주 사용한다."
SpeechStyleLine3 = "복잡하게 돌려 말하기보다 솔직하고 단순하게 자신의 생각을 전한다."

SpeechExample1 = "괜찮습니다. 제가 한번 확인해 보고 오겠습니다."
SpeechExample2 = "혼자 보내기엔 좀 걱정되는데요. 제가 같이 가면 안 됩니까?"
SpeechExample3 = "전 그 사람 믿습니다. 적어도 일부러 그런 짓을 할 사람처럼 보이진 않았어요."
StartRoomId = "guard_room"
IconColor = Color(0.72, 0.55, 0.34, 1)
