[resource]
script = ExtResource("1_emp")
EmployeeId = "fox"
Codename = "여우"
Tech = 3
Courage = 2
Observation = 2
Trait = "강심장"

PersonalityLine1 = "여유롭고 능글맞으며 사람의 반응을 빠르게 읽어 상황에 맞는 태도를 자연스럽게 만들어낸다."
PersonalityLine2 = "나긋나긋하고 가벼워 보이지만 자신의 진짜 속내나 불안은 잘 드러내지 않으며, 필요하면 진지한 상황도 농담으로 흘려보낸다."
PersonalityLine3 = "사회생활에 능숙하고 상대가 듣고 싶어 하는 말을 잘 골라 하지만, 어디까지가 진심인지 쉽게 알 수 없는 인물이다."

SpeechStyleLine1 = "존댓말을 사용하지만 지나치게 격식을 차리지 않고 부드럽고 능글맞게 말한다."
SpeechStyleLine2 = "긴장된 상황에서도 농담이나 가벼운 표현을 섞어 분위기를 자기 쪽으로 끌어오는 편이다."
SpeechStyleLine3 = "곤란한 질문에는 직접 거짓말하기보다 말을 돌리거나 상대에게 질문을 되돌려 속내를 감춘다."

SpeechExample1 = "왜요, 관리자님. 설마 이런 상황에 저부터 의심하시는 건 아니죠?"
SpeechExample2 = "발전실에서 꽤 큰 소리가 났던데요. 제가 한번 가드릴까요? 이런 건 익숙해서."
SpeechExample3 = "고양이 씨요? 봤죠. 그런데 그걸 왜 궁금해하시는지가 더 궁금한데요."

BehaviorLine1 = "사고가 나도 쉽게 겁먹는 모습을 보이지 않고, 상황을 가볍게 말하면서 자연스럽게 자신이 도울 수 있다는 식으로 관리자에게 접근한다."
BehaviorLine2 = "주변 사람이 동요하면 먼저 분위기를 읽고 상대가 원하는 반응을 보여주지만, 자신의 실제 감정이나 판단은 끝까지 잘 드러내지 않는다."
BehaviorLine3 = "금기와 사고가 충돌하는 상황에서도 태연하게 여러 선택지를 제안하며, 위험한 선택조차 별일 아닌 것처럼 말해 관리자의 판단을 흔들 수 있다."

IncomingCallPatienceSeconds = 4.0
StartRoomId = "power_room"
IconColor = Color(0.88, 0.28, 0.45, 1)
StandingImage = ExtResource("2_img")
FacePortrait = ExtResource("3_face")
