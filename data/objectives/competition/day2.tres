[gd_resource type="Resource" script_class="DayPlanDef" load_steps=5 format=3]

; ════════════════════════════════════════════════════════════════════════
; 대회용 VER — DAY2 오늘의 업무. (대회용 3일 모드 전용 폴더)
; 복구 곡선 30 → 65 → 100 의 가운데 날.
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/DayPlanDef.cs" id="1_plan"]
[ext_resource type="Script" path="res://scripts/data/DayObjectiveDef.cs" id="2_obj"]

; 누적값이라 DAY1 에서 올려 둔 만큼이 그대로 이어진다.
[sub_resource type="Resource" id="obj_core"]
script = ExtResource("2_obj")
ObjectiveId = "core"
DisplayText = "권장 복구율 65%"
Type = 0
TargetValue = 65.0
Required = true
TargetRooms = Array[String]([])

; 사전에 막았든, 터진 뒤 고쳤든 둘 다 인정한다(IncidentsResolved).
[sub_resource type="Resource" id="obj_incident"]
script = ExtResource("2_obj")
ObjectiveId = "incident"
DisplayText = "시설 경고 또는 고장 2회 해결"
Type = 2
TargetValue = 2.0
Required = true
TargetRooms = Array[String]([])

[sub_resource type="Resource" id="obj_nobreak"]
script = ExtResource("2_obj")
ObjectiveId = "nobreak"
DisplayText = "시설 고장 없이 근무 완료"
Type = 3
TargetValue = 0.0
Required = false
TargetRooms = Array[String]([])

[resource]
script = ExtResource("1_plan")
Day = 2
Note = "사고를 예방하는 쪽과 수습하는 쪽을 함께 본다."
MaxShiftSeconds = 120.0
Objectives = Array[ExtResource("2_obj")]([SubResource("obj_core"), SubResource("obj_incident"), SubResource("obj_nobreak")])
