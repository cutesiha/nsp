[gd_resource type="Resource" script_class="DayPlanDef" load_steps=5 format=3]

; ════════════════════════════════════════════════════════════════════════
; 대회용 VER — DAY3, 마지막 근무. (대회용 3일 모드 전용 폴더)
;
; 여기 코어 목표(100%)가 곧 **엔딩의 '복구 완료' 기준**이다
; (DayObjectives.FinalCoreTarget — 그 모드 마지막 날의 필수 코어 목표를 읽는다).
; 이 값을 내리면 복구 성공 엔딩의 문턱도 함께 내려간다.
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/DayPlanDef.cs" id="1_plan"]
[ext_resource type="Script" path="res://scripts/data/DayObjectiveDef.cs" id="2_obj"]

[sub_resource type="Resource" id="obj_core"]
script = ExtResource("2_obj")
ObjectiveId = "core"
DisplayText = "봉쇄 코어 복구율 100%"
Type = 0
TargetValue = 100.0
Required = true
TargetRooms = Array[String]([])

[sub_resource type="Resource" id="obj_resolve"]
script = ExtResource("2_obj")
ObjectiveId = "resolve"
DisplayText = "시설 경고 또는 고장 2회 해결"
Type = 2
TargetValue = 2.0
Required = true
TargetRooms = Array[String]([])

[sub_resource type="Resource" id="obj_rooms"]
script = ExtResource("2_obj")
ObjectiveId = "rooms"
DisplayText = "근무 종료 시 코어실·발전실 정상 가동"
Type = 4
TargetValue = 0.0
Required = false
TargetRooms = Array[String](["core_room", "power_room"])

[resource]
script = ExtResource("1_plan")
Day = 3
Note = "마지막 근무. 봉쇄 코어를 끝까지 되돌린다."
MaxShiftSeconds = 120.0
Objectives = Array[ExtResource("2_obj")]([SubResource("obj_core"), SubResource("obj_resolve"), SubResource("obj_rooms")])
