[gd_resource type="Resource" script_class="DayPlanDef" load_steps=5 format=3]

; ════════════════════════════════════════════════════════════════════════
; DAY2 오늘의 업무.
;
; DAY1 의 숫자만 올린 날이 아니다 — 이 날 처음 열리는 환기실/의무실과
; "경고든 고장이든 두 건을 처리한다" 는 복합 운영을 체험하는 날이다.
;
; Required=true 인 업무를 전부 끝내야 '근무 종료' 를 누를 수 있다.
; 선택 업무(Required=false)는 업무평가 +1 로만 반영되고 성능 보상은 없다.
; ※ 방해공작·결번자 관련 항목은 절대 넣지 않는다.
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/DayPlanDef.cs" id="1_plan"]
[ext_resource type="Script" path="res://scripts/data/DayObjectiveDef.cs" id="2_obj"]

; 5일짜리 장기 목표. 누적값이라 DAY1 에서 올려 둔 만큼이 그대로 이어진다.
[sub_resource type="Resource" id="obj_core"]
script = ExtResource("2_obj")
ObjectiveId = "core"
DisplayText = "봉쇄 코어 누적 복구율 38% 달성"
Type = 0
TargetValue = 38.0
Required = true
TargetRooms = Array[String]([])

; 사전에 막았든, 터진 뒤 고쳤든 둘 다 인정한다(IncidentsResolved).
[sub_resource type="Resource" id="obj_incident"]
script = ExtResource("2_obj")
ObjectiveId = "incident"
DisplayText = "시설 경고 또는 고장 2회 해결"
Type = 2
TargetValue = 2.0
Required = true
TargetRooms = Array[String]([])

; 오늘 처음 열리는 두 작업실. 실패해도 진행은 막히지 않는다.
[sub_resource type="Resource" id="obj_newrooms"]
script = ExtResource("2_obj")
ObjectiveId = "newrooms"
DisplayText = "근무 종료 시 환기실·의무실 정상 가동"
Type = 4
TargetValue = 2.0
Required = false
TargetRooms = Array[String](["vent_room", "medical_room"])

[resource]
script = ExtResource("1_plan")
Day = 2
Note = "환기실·의무실 해금 + 복합 운영. 숫자보다 시스템이 늘어난 날."
MaxShiftSeconds = 120.0
Objectives = Array[ExtResource("2_obj")]([SubResource("obj_core"), SubResource("obj_incident"), SubResource("obj_newrooms")])
