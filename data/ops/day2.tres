[gd_resource type="Resource" script_class="OpsProfileDef" load_steps=13 format=3]

; ════════════════════════════════════════════════════════════════════════
; DAY2 운영 규칙 — DAY1 과 같은 표에서 아주 조금만 조인 것.
; 이 날의 진짜 난이도 상승은 숫자가 아니라 새로 켜지는 시스템에서 온다
; (능력치 · 스트레스 · 금기 1개 · 환기실 · 의무실).
;
; 여기 숫자만 고치면 밸런스가 바뀐다. 코드 수정 불필요.
; 인원수별 배열은 index = 그 방의 근무 인원(0명, 1명, 2명 …). 표 끝을 넘는 인원은
; 마지막 값을 그대로 쓴다 — "3명째부터 증가폭이 거의 없다"를 그렇게 표현한다.
;
; DAY3~5 를 만들 때는 Day 값만 다른 .tres 를 이 폴더에 하나 더 넣으면 된다.
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/OpsProfileDef.cs" id="1_profile"]
[ext_resource type="Script" path="res://scripts/data/RoomOpsDef.cs" id="2_roomops"]
[ext_resource type="Script" path="res://scripts/data/ScheduledWarningDef.cs" id="3_warn"]

; ── 발전실 ───────────────────────────────────────────────────────────────
; 1명으로도 돌아가지만 과열 경고가 자주 뜬다. 2명이면 거의 조용하다.
; 0명이면 시설 전체 출력이 35% 로 떨어지고 점검할 때마다 경고가 뜬다.
[sub_resource type="Resource" id="ops_power"]
script = ExtResource("2_roomops")
RoomId = "power_room"
RoleNote = "0명 발전 중단 · 시설 전체 35% / 1명 불안정 · 과열 경고 잦음 / 2명 이상 안정(3명부터 추가 효율 없음)"
Efficiency = PackedFloat32Array(0, 0.75, 1, 1.05, 1.05)
FacilityOutput = PackedFloat32Array(0.35, 0.9, 1, 1, 1)
OutputWhileBroken = 0.4
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "발전기 과열"
WarningCause = "냉각 부하 상승"
WarningConsequence = "정전 · 사용 전력 감소"
WarningChance = PackedFloat32Array(1, 0.56, 0.04, 0, 0)
WarningCheckSeconds = 14.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 2
WarningCooldownSeconds = 14.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 16.0
RepairMinWorkers = 2

; ── 코어실 ───────────────────────────────────────────────────────────────
; 그 날의 복구량을 그대로 결정한다. 1명은 기준의 62%, 3명째부터 증가폭이 준다.
[sub_resource type="Resource" id="ops_core"]
script = ExtResource("2_roomops")
RoomId = "core_room"
RoleNote = "0명 복구 정지 / 1명 기준의 62% · 2명 100% / 3명 128%(그 이상 증가폭 감소)"
Efficiency = PackedFloat32Array(0, 0.68, 1, 1.15, 1.2)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 1.0
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "코어 출력 흔들림"
WarningCause = "봉쇄 출력 변동 감지"
WarningConsequence = "코어 복구 정지"
WarningChance = PackedFloat32Array(0, 0, 0, 0)
WarningCheckSeconds = 22.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 2
WarningCooldownSeconds = 20.0
UnstaffedAccidentSeconds = 30.0
RepairSeconds = 14.0
RepairMinWorkers = 2

; ── 정비실 ───────────────────────────────────────────────────────────────
; 자재를 만들고, 인원이 많으면 시설 전체의 이상 징후를 미리 잡는다.
[sub_resource type="Resource" id="ops_maintenance"]
script = ExtResource("2_roomops")
RoomId = "maintenance_room"
RoleNote = "자재를 만든다 — 비우면 코어 복구가 멈춘다 / 2명이면 생산 130% / 2명 이상이면 시설 전체 경고 30% 감소"
Efficiency = PackedFloat32Array(0, 1, 1.3, 1.4, 1.45)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.62
FacilityWarningChance = PackedFloat32Array(1.3, 1, 0.7, 0.62, 0.6)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "정비 설비 과부하"
WarningCause = "구동부 진동 증가"
WarningConsequence = "자재 생산 정지"
WarningChance = PackedFloat32Array(0.4, 0.08, 0.01, 0, 0)
WarningCheckSeconds = 20.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 2
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 12.0
RepairMinWorkers = 1

; ── 경비실 ───────────────────────────────────────────────────────────────
; 방해공작을 어렵게 만들고, 2명부터는 순찰 기록(추리 단서)을 남긴다.
; 범인을 알려주지는 않는다 — "그 시각 그 방에 누가 있었나"만 남는다.
[sub_resource type="Resource" id="ops_guard"]
script = ExtResource("2_roomops")
RoomId = "guard_room"
RoleNote = "0명 방해공작이 쉬워진다 / 1명 방해공작 40% 억제 / 2명 이상 순찰 기록(휴게시간 단서) 추가"
Efficiency = PackedFloat32Array(0, 1, 1.4, 1.5)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 1.0
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1.25, 0.6, 0.42, 0.38)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 24, 15, 12)
WarningTitle = "감시 계통 잡음"
WarningCause = "신호 품질 저하"
WarningConsequence = "CCTV 신호 단절"
WarningChance = PackedFloat32Array(0, 0, 0, 0)
WarningCheckSeconds = 22.0
WarningResponseSeconds = 13.0
WarningRequiredStaff = 1
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 10.0
RepairMinWorkers = 1

; ── 저장고 ───────────────────────────────────────────────────────────────
; 반드시 한 명 넣어야 하는 방이 아니다. 비워도 즉시 문제는 없지만
; 자재 낭비가 늘어 장기적으로 코어 복구가 먼저 말라붙는다.
[sub_resource type="Resource" id="ops_storage"]
script = ExtResource("2_roomops")
RoomId = "storage_room"
RoleNote = "비워 둬도 당장은 문제없다 / 0명이면 자재 소모 +25% / 2명 이상이면 자재 소모 25% 감소"
Efficiency = PackedFloat32Array(0, 1, 1.3, 1.4)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.85
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1.25, 1, 0.75, 0.7)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "보관 선반 흔들림"
WarningCause = "적재 불균형"
WarningConsequence = "자재 보유 한도 감소"
WarningChance = PackedFloat32Array(0, 0, 0, 0)
WarningCheckSeconds = 22.0
WarningResponseSeconds = 13.0
WarningRequiredStaff = 2
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 10.0
RepairMinWorkers = 1

; ── 환기실 (DAY2 해금) ───────────────────────────────────────────────────
; 사람이 없어도 저절로 터지지는 않는다. 대신 환기 점검 업무가 뜨면 사람이 필요하고,
; 선택 업무(두 신규 작업실 정상 가동)가 이 방을 신경 쓰게 만든다.
[sub_resource type="Resource" id="ops_vent"]
script = ExtResource("2_roomops")
RoomId = "vent_room"
RoleNote = "DAY2 해금 / 비워 둬도 즉시 사고는 없다 / 환기 점검이 뜨면 1명 필요"
Efficiency = PackedFloat32Array(0, 1, 1.25, 1.3)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.9
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "환기 순환 저하"
WarningCause = "필터 막힘"
WarningConsequence = "환기 정지"
WarningChance = PackedFloat32Array(0, 0, 0, 0)
WarningCheckSeconds = 24.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 1
WarningCooldownSeconds = 20.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 10.0
RepairMinWorkers = 1

; ── 의무실 (DAY2 해금) ───────────────────────────────────────────────────
; 스트레스가 켜지는 날이라 처음으로 "사람을 쉬게 하는 방"이 의미를 갖는다.
[sub_resource type="Resource" id="ops_medical"]
script = ExtResource("2_roomops")
RoomId = "medical_room"
RoleNote = "DAY2 해금 / 스트레스 회복 / 비워 둬도 즉시 사고는 없다"
Efficiency = PackedFloat32Array(0, 1, 1.25, 1.3)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.95
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "의료 설비 이상"
WarningCause = "장비 오염"
WarningConsequence = "치료 불가"
WarningChance = PackedFloat32Array(0, 0, 0, 0)
WarningCheckSeconds = 24.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 1
WarningCooldownSeconds = 20.0
UnstaffedAccidentSeconds = 0.0
RepairSeconds = 10.0
RepairMinWorkers = 1

; ── 정해진 시각의 경고 ───────────────────────────────────────────────────
; 배치를 어떻게 했든 근무 중 최소 두 번은 인력을 옮기게 만든다.
[sub_resource type="Resource" id="sched_maintenance"]
script = ExtResource("3_warn")
AtSeconds = 22.0
JitterSeconds = 4.0
RoomId = "maintenance_room"
RequiredStaff = 2
ResponseSeconds = 15.0

[sub_resource type="Resource" id="sched_power"]
script = ExtResource("3_warn")
AtSeconds = 50.0
JitterSeconds = 5.0
RoomId = "power_room"
RequiredStaff = 2
ResponseSeconds = 15.0

; 근무 막바지 — 방해공작 수습과 겹치는 마지막 판단거리.
[sub_resource type="Resource" id="sched_storage"]
script = ExtResource("3_warn")
AtSeconds = 96.0
JitterSeconds = 5.0
RoomId = "storage_room"
RequiredStaff = 1
ResponseSeconds = 14.0

[resource]
script = ExtResource("1_profile")
Day = 2
Note = "DAY2 — 능력치·스트레스·금기·환기실·의무실이 처음 켜지는 날. 수치 상승은 최소."
Rooms = Array[ExtResource("2_roomops")]([SubResource("ops_power"), SubResource("ops_core"), SubResource("ops_maintenance"), SubResource("ops_guard"), SubResource("ops_storage"), SubResource("ops_vent"), SubResource("ops_medical")])
TargetCoreGain = 20.0
MaxConcurrentWarnings = 1
WarningGapSeconds = 10.5
WarningGraceSeconds = 14.0
WarningCutoffSeconds = 14.0
ScheduledWarnings = Array[ExtResource("3_warn")]([SubResource("sched_maintenance"), SubResource("sched_power"), SubResource("sched_storage")])
SaboteurStartSeconds = 58.0
MaxSabotageActionsPerDay = 1
AllowMurder = false
DailyTabooIds = Array[String](["taboo_vent_low_courage_alone"])
SabotageTargetRooms = Array[String](["core_room", "power_room", "maintenance_room", "storage_room", "guard_room"])
SabotageSettleSeconds = 7.0
SabotagePrepareMinSeconds = 10.0
SabotagePrepareMaxSeconds = 13.0
SabotageWindowStartSeconds = 74.0
SabotageWindowEndSeconds = 96.0
MaxReactionMovesPerDay = 2
ReactionMoveGapSeconds = 26.0
ReactionStaySeconds = 18.0
