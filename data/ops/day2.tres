[gd_resource type="Resource" script_class="OpsProfileDef" load_steps=11 format=3]

; ════════════════════════════════════════════════════════════════════════
; DAY2 운영 규칙 — DAY1 과 같은 시스템(작업실 7개 · 스트레스 있음 · 능력치 · 금기 없음).
; (예전에는 DAY2 부터 능력치 · 스트레스 · 금기 · 환기실 · 의무실이 켜졌지만 전부 뺐다.)
; DAY1 표에서 경고 간격 · 방해공작 시각만 조금 앞당겼다. 여기 숫자만 고치면 된다.
; DAY3~5 는 day3~5.tres 가 따로 있다(날마다 경고 시각 · 작업실 · 방해 구간이 다르다).
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/OpsProfileDef.cs" id="1_profile"]
[ext_resource type="Script" path="res://scripts/data/RoomOpsDef.cs" id="2_roomops"]
[ext_resource type="Script" path="res://scripts/data/ScheduledWarningDef.cs" id="3_warn"]

; ── 발전실 ───────────────────────────────────────────────────────────────
; 1명으로도 돌아가지만 과열 경고가 자주 뜬다. 2명이면 거의 조용하다.
; 0명이면 시설 전체 출력이 35% 로 떨어지고 점검할 때마다 경고가 뜬다.
[sub_resource type="Resource" id="ops_power"]
script = ExtResource("2_roomops")
RoomId = "power_room"
RoleNote = "0명 발전 중단 · 시설 전체 35% / 1명 불안정 · 과열 경고 잦음 / 2명 이상 안정(3명부터 추가 효율 없음)"
Efficiency = PackedFloat32Array(0, 0.75, 1, 1.05, 1.05)
FacilityOutput = PackedFloat32Array(0.35, 0.9, 1, 1, 1)
OutputWhileBroken = 0.4
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "발전기 과열"
WarningCause = "냉각 부하 상승"
WarningConsequence = "정전 · 사용 전력 감소"
WarningChance = PackedFloat32Array(1, 0.06885, 0.035, 0, 0)
WarningCheckSeconds = 11.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 2
WarningStabilizeSeconds = 3.6
WarningCooldownSeconds = 14.0
UnstaffedAccidentSeconds = 26.0
RepairSeconds = 9.0
RepairMinWorkers = 2

; ── 코어실 ───────────────────────────────────────────────────────────────
; 그 날의 복구량을 그대로 결정한다. 1명은 기준의 62%, 3명째부터 증가폭이 준다.
[sub_resource type="Resource" id="ops_core"]
script = ExtResource("2_roomops")
RoomId = "core_room"
RoleNote = "0명 복구 정지 / 1명 기준의 62% · 2명 100% / 3명 128%(그 이상 증가폭 감소)"
Efficiency = PackedFloat32Array(0, 0.68, 1, 1.15, 1.2)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 1.0
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "코어 출력 흔들림"
WarningCause = "봉쇄 출력 변동 감지"
WarningConsequence = "코어 복구 정지"
WarningChance = PackedFloat32Array(0, 0.02025, 0.014, 0, 0)
WarningCheckSeconds = 16.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 2
WarningStabilizeSeconds = 3.2
WarningCooldownSeconds = 20.0
UnstaffedAccidentSeconds = 28.0
RepairSeconds = 8.0
RepairMinWorkers = 2

; ── 정비실 ───────────────────────────────────────────────────────────────
; 자재를 만들고, 인원이 많으면 시설 전체의 이상 징후를 미리 잡는다.
[sub_resource type="Resource" id="ops_maintenance"]
script = ExtResource("2_roomops")
RoomId = "maintenance_room"
RoleNote = "자재를 만든다 — 비우면 코어 복구가 멈춘다 / 2명이면 생산 130% / 2명 이상이면 시설 전체 경고 30% 감소"
Efficiency = PackedFloat32Array(0, 1, 1.3, 1.4, 1.45)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.62
FacilityWarningChance = PackedFloat32Array(1.3, 1, 0.7, 0.62, 0.6)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "정비 설비 과부하"
WarningCause = "구동부 진동 증가"
WarningConsequence = "자재 생산 정지"
WarningChance = PackedFloat32Array(0.45, 0.0243, 0.014, 0, 0)
WarningCheckSeconds = 15.0
WarningResponseSeconds = 14.0
WarningRequiredStaff = 1
WarningStabilizeSeconds = 3.0
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 34.0
RepairSeconds = 7.0
RepairMinWorkers = 1

; ── 경비실 ───────────────────────────────────────────────────────────────
; 방해공작을 어렵게 만들고, 2명부터는 순찰 기록(추리 단서)을 남긴다.
; 범인을 알려주지는 않는다 — "그 시각 그 방에 누가 있었나"만 남는다.
[sub_resource type="Resource" id="ops_guard"]
script = ExtResource("2_roomops")
RoomId = "guard_room"
RoleNote = "0명 방해공작이 쉬워진다 / 1명 방해공작 40% 억제 / 2명 이상 순찰 기록(휴게시간 단서) 추가"
Efficiency = PackedFloat32Array(0, 1, 1.4, 1.5)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 1.0
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1.25, 0.6, 0.42, 0.38)
MaterialCost = PackedFloat32Array(1, 1, 1, 1)
PatrolIntervalSeconds = PackedFloat32Array(0, 24, 15, 12)
WarningTitle = "감시 계통 잡음"
WarningCause = "신호 품질 저하"
WarningConsequence = "CCTV 신호 단절"
WarningChance = PackedFloat32Array(0, 0.0162, 0.014, 0)
WarningCheckSeconds = 18.0
WarningResponseSeconds = 13.0
WarningRequiredStaff = 1
WarningStabilizeSeconds = 2.5
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 34.0
RepairSeconds = 6.0
RepairMinWorkers = 1

; ── 저장고 ───────────────────────────────────────────────────────────────
; 반드시 한 명 넣어야 하는 방이 아니다. 비워도 즉시 문제는 없지만
; 자재 낭비가 늘어 장기적으로 코어 복구가 먼저 말라붙는다.
[sub_resource type="Resource" id="ops_storage"]
script = ExtResource("2_roomops")
RoomId = "storage_room"
RoleNote = "비워 둬도 당장은 문제없다 / 0명이면 자재 소모 +25% / 2명 이상이면 자재 소모 25% 감소"
Efficiency = PackedFloat32Array(0, 1, 1.3, 1.4)
FacilityOutput = PackedFloat32Array(1, 1, 1, 1)
OutputWhileBroken = 0.85
FacilityWarningChance = PackedFloat32Array(1, 1, 1, 1)
SabotageChance = PackedFloat32Array(1, 1, 1, 1)
MaterialCost = PackedFloat32Array(1.25, 1, 0.75, 0.7)
PatrolIntervalSeconds = PackedFloat32Array(0, 0, 0, 0)
WarningTitle = "보관 선반 흔들림"
WarningCause = "적재 불균형"
WarningConsequence = "자재 보유 한도 감소"
WarningChance = PackedFloat32Array(0, 0.0162, 0.014, 0)
WarningCheckSeconds = 18.0
WarningResponseSeconds = 13.0
WarningRequiredStaff = 1
WarningStabilizeSeconds = 2.4
WarningCooldownSeconds = 18.0
UnstaffedAccidentSeconds = 68.0
RepairSeconds = 6.0
RepairMinWorkers = 1

; ── 정해진 시각의 경고 ───────────────────────────────────────────────────
; DAY2 — DAY1(정비실 → 발전실 → 저장고)과 순서를 바꿔 저장고 → 경비실 → 발전실.
[sub_resource type="Resource" id="sched_d2_0"]
script = ExtResource("3_warn")
AtSeconds = 24.0
JitterSeconds = 4.0
RoomId = "storage_room"
; 필요 인원은 그 방이 정한다(코어·발전 2명 / 나머지 1명) — 0 = 방 설정 사용
RequiredStaff = 0
ResponseSeconds = 15.0

[sub_resource type="Resource" id="sched_d2_1"]
script = ExtResource("3_warn")
AtSeconds = 54.0
JitterSeconds = 5.0
RoomId = "guard_room"
; 필요 인원은 그 방이 정한다(코어·발전 2명 / 나머지 1명) — 0 = 방 설정 사용
RequiredStaff = 0
ResponseSeconds = 15.0

[sub_resource type="Resource" id="sched_d2_2"]
script = ExtResource("3_warn")
AtSeconds = 90.0
JitterSeconds = 5.0
RoomId = "power_room"
; 필요 인원은 그 방이 정한다(코어·발전 2명 / 나머지 1명) — 0 = 방 설정 사용
RequiredStaff = 0
ResponseSeconds = 14.0

[resource]
script = ExtResource("1_profile")
Day = 2
Note = "DAY2 — 저장고 → 경비실 → 발전실 순서로 경고가 뜨고, 정비실에 설비 고장 수리가 한 번 발생한다."
Rooms = Array[ExtResource("2_roomops")]([SubResource("ops_power"), SubResource("ops_core"), SubResource("ops_maintenance"), SubResource("ops_guard"), SubResource("ops_storage")])
TargetCoreGain = 20.0
MaxConcurrentWarnings = 1
MaxWarningsPerDay = 7
WarningGapSeconds = 7.0
WarningGraceSeconds = 12.0
WarningCutoffSeconds = 14.0
ScheduledWarnings = Array[ExtResource("3_warn")]([SubResource("sched_d2_0"), SubResource("sched_d2_1"), SubResource("sched_d2_2")])
SaboteurStartSeconds = 26.0
MaxSabotageActionsPerDay = 2
AllowMurder = true
GhostMaxPerDay = 2
; 두 번째 개체는 봉쇄 불안정이 75% 를 넘었을 때만 나올 수 있다(화면 게이지에 눈금으로 찍힌다).
; (2026-10-29 — 게이지가 50% 에서 시작하므로 눈금을 50 → 75 로 올리고 흔들림을 늦췄다. 눈금에 닿는 시각은 예전과 같다.)
; 저절로 쌓이는 몫만으로는 근무 끝자락에야 닿는다 — CCTV 를 꺼 둬 교란을 허용하면 일찍 넘는다.
; 결번을 격리하면 첫 번째도 나오지 않는다 — 귀신은 결번이 불러오는 것이다.
GhostExtraNeedsInstability = 75.0
; 하루 한 번은 **반드시** 나온다. 추첨에만 맡기면 하루 한도가 1 이라 운이 나쁜 날은
; 중앙제어실 쪽 위협이 통째로 0 이 된다(근무 150초 중 열 번 중 한 번꼴).
; 늦게 나오면 복도를 걸어올 시간이 모자라 그대로 근무가 끝나므로 앞쪽에 둔다.
GhostFirstAppearFromSeconds = 28.0
GhostFirstAppearBySeconds = 48.0
SabotageTargetRooms = Array[String](["core_room", "power_room", "storage_room", "guard_room", "maintenance_room", "vent_room", "medical_room"])
SabotageSettleSeconds = 4.5
SabotagePrepareMinSeconds = 6.0
SabotagePrepareMaxSeconds = 8.0
TamperAttemptsPerDay = 1
TamperWindowStartSeconds = 40.0
TamperWindowEndSeconds = 95.0
TamperCrossRoomChance = 0.7
SabotageWindowStartSeconds = 30.0
SabotageWindowEndSeconds = 85.0
; 손댄 뒤 12~28초 지나 진짜 고장으로 드러난다. 혼자 있던 방에서 손댔으면 언제나 다른 방에서,
; 동료가 있었으면 절반 확률로 다른 방에서 — 고장 난 방에 있던 사람이 범인이 아니다.
SabotageDelayMinSeconds = 12.0
SabotageDelayMaxSeconds = 28.0
SabotageCrossRoomChance = 0.5
MaxReactionMovesPerDay = 2
ReactionMoveGapSeconds = 26.0
ReactionStaySeconds = 18.0

; ── 감시 공백 이용 (DAY2 — 조건부 살인이 열린다) ───────────────────────
; 조명 OFF 가 길어지면 결번이 실제로 걸어서 다른 방에 간다. 차폐문에 막히면 못 간다.
; 같은 방에 도달해 10초를 버텨야 범행이 성립하고, 그 10초 안에 관리자가 개입하면 멈춘다.
AllowCovertMove = true
CovertMoveAfterSeconds = 10.0
CovertKillPrepareSeconds = 11.0
CovertAbortOnLightChance = 0.5
ContainmentRooms = Array[String](["core_room", "power_room", "maintenance_room", "vent_room"])
ContainmentTamperAfterSeconds = 8.0
ContainmentWorkSeconds = 7.0
ContainmentTampersPerDay = 2
ContainmentInstabilityPerTamper = 18.0
; 결번이 풀려 있는 동안 봉쇄가 저절로 흔들리는 속도. 감쇠(0.22/초)를 빼면 초당 +0.23 —
; 50% 에서 시작해 근무 끝자락에 눈금(75%)에 닿는다. 결번을 격리하면 멈추고 이상 개체도 나오지 않는다.
ContainmentDriftPerSecond = 0.45
; 2026-10-29 — 근무는 봉쇄가 반쯤 흔들린 50% 에서 시작한다(결번을 격리하면 여기서 0 까지 내려간다).
ContainmentStartInstability = 50.0
