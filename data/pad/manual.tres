[gd_resource type="Resource" script_class="PadManualDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/PadManualDef.cs" id="1_manual"]

[resource]
script = ExtResource("1_manual")
Title = "관리자 지침"
Lines = PackedStringArray("# 목표", "비상 차폐가 유지되는 120시간(5일) 안에 봉쇄 코어를 100%까지 복구하십시오.", "직원 중 누군가는 개체가 둔갑한 결번자입니다. 시스템은 범인의 신원을 알려주지 않습니다. 관리자님께서 직접 알아내셔야 합니다.", "# 하루의 흐름", "① 근무 배치 — 책상 위 배치표에서 직원을 작업실에 배치하고 「근무 시작」을 누릅니다.", "② 근무 — 왼쪽 모니터(시설 지도)와 오른쪽 모니터(CCTV)로 시설을 운영합니다. 사고가 나면 직원을 끌어다 다른 방으로 옮길 수 있습니다.", "③ 정산 — 왼쪽 모니터의 「근무 종료」로 하루를 마치면 그날의 결과가 나옵니다.", "④ 휴게시간 — 직원을 골라 수화기를 들면 심문할 수 있습니다. 조사 자료로 질문하고, 두 자료를 맞대어 추궁하십시오.", "# 조작", "숫자 키 1 · 2 — 왼쪽 · 오른쪽 모니터 확대. 같은 키 또는 ESC 로 복귀.", "L — 시설 기록. 이동 · 사고 줄의 ☆ 를 누르면 이 패드에 단서로 보관됩니다.", "D — 대화 기록.  T — 오늘의 업무.", "F — CCTV 로 방금 엿들은 대화를 단서로 보관(자막을 눌러도 됩니다).", "Tab · 오른쪽 위 패드 버튼(톱니바퀴 아래) · 책상 위 패드 클릭 — 관리자 패드. 패드를 보는 동안 근무 시간은 멈춥니다. 우클릭 또는 Tab 으로 내려놓습니다.", "전화기 — 직원에게 직접 걸 수 있고, 직원이 먼저 걸기도 합니다. 직원의 진술이 모두 진실이라는 보장은 없습니다.", "# 전력", "발전실이 시설 전력을 공급합니다. 전력이 없으면 CCTV, 조명 등을 켤 수 없습니다.", "전력 패널의 세 채널은 조명 · CCTV · 센서입니다. 켤 수 있는 채널 수는 전력 용량만큼이며, 정전이 나면 용량이 줄어듭니다.", "조명 — 누가 어디에 있는지. CCTV — 무엇이 벌어지는지. 센서 — 언제, 다음에 무엇이 올지.", "# 작업실", "코어실 — 봉쇄 코어를 관리하고 복구하는 핵심 작업실입니다.", "정비실 — 코어 복구에 필요한 자재를 생산합니다. 저장고 — 자재의 상한을 관리합니다.", "경비실 — 시설을 감시합니다. 인원을 배치하면 방해공작 억제에 도움이 되고, 재석 기록이 남습니다.", "환기실 — 공조를 유지해 스트레스 상승을 억제합니다. 의무실 — 스트레스가 높은 직원을 회복시키며, 기절한 직원도 이곳으로 이송됩니다.", "# 코어와 자재", "코어 복구에는 자재가 필요합니다. 자재가 떨어지면 코어 작업이 멈춥니다 — 정비실과 저장고를 비우지 마십시오.", "그날의 필수 업무를 끝내야 근무를 종료할 수 있습니다(T — 오늘의 업무).", "# 격리", "격리실은 의심되는 직원을 다른 직원들과 분리하는 공간입니다.", "격리된 직원은 근무에서 빠집니다. 일할 수 있는 직원이 없으면 시설은 무너집니다 — 판단은 신중하게 하십시오.", "# 이상 개체", "정체불명의 개체는 센서에도 잡히지 않고 경고도 울리지 않습니다. CCTV 를 직접 돌려 찾으십시오.", "개체는 관측되는 것을 견디지 못합니다. 찾았다면 화면을 돌리지 말고 그대로 계속 보십시오.")
