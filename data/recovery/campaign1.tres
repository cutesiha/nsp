[gd_resource type="Resource" script_class="RecoveryProfileDef" load_steps=2 format=3]

; ════════════════════════════════════════════════════════════════════════
; 1차 5일 — 스토리 캠페인(초보자).
; 시스템을 배우면서 첫 엔딩까지 갈 수 있어야 한다. 코어실 1명으로도 기본 복구가 돈다.
; ════════════════════════════════════════════════════════════════════════

[ext_resource type="Script" path="res://scripts/data/RecoveryProfileDef.cs" id="1_profile"]

[resource]
script = ExtResource("1_profile")
ProfileId = "campaign1"
DisplayName = "1차 복구 · 스토리"
; 코어 복구 속도·수율은 5일에 걸쳐 100% 가 되도록 잡혀 있다.
; 예전 값(RateMultiplier 1.45 · YieldMultiplier 2.6)은 DAY1 하루에만 +64% 가 차서
; DAY2 중에 100% 를 찍고 남은 사흘이 통째로 의미를 잃었다(RecoveryBalanceTest 참고).
; 목표는 RecommendedByDay 의 16/34/55/80/100 곡선이다.
;
; DayRecoveryMultiplier 가 1 이 아닌 이유 — 시스템 자체는 날마다 평평하다(코어실 2명을
; 고정하고 사고를 무시하면 DAY1~5 가 +11~19% 로 고르게 나온다). 후반에 복구가 꺾이는 것은
; **사고가 늘어 코어실에서 사람을 빼야 하기 때문**이고, 그건 의도된 압박이다.
; 그래서 평평한 기본 속도 하나로는 'DAY1 에 16%' 와 'DAY5 에 100%' 를 동시에 못 맞춘다.
; 기본 속도는 DAY1 이 목표에 닿게 잡고, 뒤로 갈수록 줄어드는 '코어실에 쓸 수 있는 시간'을
; 이 배율이 되받는다. 값은 RecoveryBalanceTest 의 자동 탐색 결과를 반올림한 것이다.
;
; 남은 문제 — DAY4~5 는 이 배율을 더 올려도 거의 오르지 않는다(1.95→3.2 로 올려도 최종이
; 60%→66% 뿐이었다). 그 이틀은 사고가 몰려 코어실에 사람을 둘 시간 자체가 없고, 2차·3차
; 표에서는 아예 코어가 **줄어든다**(평균 패턴 DAY3 67% → DAY5 64%). 배율로 덮을 문제가
; 아니라 그 이틀의 사고 밀도 · 방해 피해 · CoreStaffCurve 쪽에서 풀어야 한다.
; 수율을 함께 내린 이유 — 자재 소모는 정수라 1회 1개 밑으로 못 내려간다. 속도만 내리면
; 코어가 자재를 거의 안 먹어 정비실·저장고가 장식이 된다(실제로 하루 6개씩 버려지고 있었다).
; 0명 정지 / 1명 130% / 2명 160% / 3명 180% / 4명부터 거의 안 오른다
; 1명 값이 높은 이유 — 이 캠페인의 타깃은 게임에 익숙하지 않은 사람이고, 그 사람들은
; 코어실에 한 명만 두고 나머지를 사고 대응에 쓴다. 1명을 올려야 그 층이 올라간다.
CoreStaffCurve = PackedFloat32Array(0, 1.3, 1.6, 1.8, 1.85)
DayRecoveryMultiplier = PackedFloat32Array(1.0, 1.55, 2.1, 3.4, 3.6)
CoreRateMultiplier = 0.5
CoreYieldMultiplier = 1.95
CoreMaterialCostMultiplier = 0.5
StressGainMultiplier = 0.65
MedicalStressRecoveryMultiplier = 1.5
MaterialProductionMultiplier = 1.5
MaterialsCapFloor = 14
SabotageCoreDamageMultiplier = 0.3
CoreInstabilityLossMultiplier = 0.25
; 뒤처진 판에만 걸리는 보정 — 이 캠페인의 타깃이 게임에 익숙하지 않은 사람이라
; "못해도 5일 안에 끝은 본다"를 이 값으로 보장한다.
;
; 높은 단계 문턱이 22 인 이유 — 근무 시작 시점에는 누구나 그 날 권장치만큼 뒤처져 있다
; (DAY1 은 16). 문턱이 그보다 낮으면 DAY1 첫 순간부터 보정이 걸려 초반이 다시 폭주한다.
; 22 면 DAY1 에는 절대 안 걸리고, 실제로 처지기 시작하는 DAY3~5 에만 붙는다.
; 잘하고 있는 판(권장치에 붙어 있는 판)은 BehindBy 가 0 이라 아무 영향도 받지 않는다.
CatchupEnabled = true
CatchupMidThreshold = 10.0
CatchupHighThreshold = 22.0
CatchupMidMultiplier = 1.15
CatchupHighMultiplier = 4.0
RecommendedByDay = PackedFloat32Array(16, 34, 55, 80, 100)
