[gd_resource type="Resource" script_class="RoomDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/RoomDef.cs" id="1_room"]

[resource]
script = ExtResource("1_room")
RoomId = "medical_room"
DisplayName = "의무실"
Summary = "기절한 직원을 회복시키고 스트레스를 낮춘다."
BriefLines = PackedStringArray("· 기절한 직원은 이곳 침대에서만 깨어난다", "· 진료 — 방 안 직원의 스트레스 감소", "⚠ 고장 나면 회복이 느려지고 진료가 멈춘다")
ConnectedRoomIds = Array[String](["central_office", "vent_room", "maintenance_room", "isolation_room"])
AdjacentRoomIds = Array[String](["vent_room", "maintenance_room", "isolation_room"])
MapPosition = Vector2(450, 560)
; 띠 시간표에서 이 방을 나타내는 색 — 의무실 분홍
MapColor = Color(0.86, 0.46, 0.52, 1)
IsCoreRoom = false
UnlockDay = 1
ManagedResource = 4
AccidentName = "의료 장비 오염"
; 0 = 비워 둬도 무인 사고가 나지 않는다.
; 환기실·의무실은 오늘의 운영 규칙(data/ops)에 든 작업실 5개에 들어가지 않는다.
; 직원 6명으로는 다섯 작업실을 채우는 것이 한계라 여기까지 상주를 요구하면,
; 관리자가 아무 실수를 하지 않아도 25초마다 사고가 터진다(승인 요청도 같이 뜬다).
; 비워 둔 대가는 따로 있다 — 환기실은 전 직원 스트레스 상승, 의무실은 회복 지연.
UnstaffedAccidentSeconds = 0.0
AccidentConsequence = 9
AccidentAmount = 0.0
RepairTaskId = "repair_medical"
RepairSeconds = 8.0
