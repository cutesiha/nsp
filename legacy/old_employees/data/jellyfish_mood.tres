[gd_resource type="Resource" script_class="MoodPoolDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/MoodPoolDef.cs" id="1_mood"]

; 표현은 전부 docs/NSP_V3_REWORK_REVISED.md 의 기분상태 목록에서 가져온다.
; CalmMoods = DAY1(이전 사건 없음) 용. Light/Strong 은 이후 DAY 확장용이며 현재는 쓰이지 않는다.

[resource]
script = ExtResource("1_mood")
EmployeeId = "jellyfish"
CalmMoods = Array[String](["조금 긴장됨", "걱정됨", "괜찮음", "조금 불안함"])
VagueMoods = Array[String](["잘 모르겠음"])
LightEventMoods = Array[String](["찝찝함", "신경 쓰임", "걱정됨", "불편함"])
StrongEventMoods = Array[String](["충격받음", "무서움", "잠을 못 잤음", "아직 진정이 안 됨"])
